@inproceedings{2022-sok-private-bitcoin ,
author = {Ghesmati, Simin and Fdhila, Walid and Weippl, Edgar},
title = {SoK: How Private is Bitcoin? Classification and Evaluation of Bitcoin Privacy Techniques},
year = {2022},
isbn = {9781450396707},
